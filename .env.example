# Copy to .env and fill in real values. Never commit .env.

# --- Groq (grounded answer generation only) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
# Output budget includes hidden reasoning tokens on gpt-oss models
GROQ_MAX_COMPLETION_TOKENS=4096
# none | low | medium | high (leave empty for models without reasoning)
GROQ_REASONING_EFFORT=low

# --- Embeddings (local ONNX MiniLM; same model for index and query) ---
# fake | local
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# fake | groq
GENERATION_PROVIDER=groq

# --- Admin protection for ingest and retrieval debug ---
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- CORS: comma-separated origins, no wildcards in production ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Paths ---
DATA_DIR=data
DOCUMENTS_DIR=data/documents
CHROMA_DIR=data/chroma

# --- Chunking ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# --- Retrieval (cosine distance; lower is closer). Calibrate on a real prospectus. ---
RETRIEVAL_TOP_K=12
RETRIEVAL_MAX_DISTANCE=0.72

# --- Uploads and limits ---
MAX_UPLOAD_MB=50
MAX_QUESTION_CHARS=2000
CHAT_RATE_LIMIT_PER_MINUTE=30

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
